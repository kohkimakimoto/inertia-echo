{
  "name": "ssr-slowjs",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --clearScreen=false",
    "build": "tsc --noEmit && vite build && npm run build:ssr",
    "build:ssr": "vite build --mode ssr",
    "clean": "rm -rf resources/public/build && rm -rf .build && rm -rf app"
  },
  "license": "ISC",
  "description": "PoC: Inertia SSR inside the Go process via liustack/slowjs",
  "devDependencies": {
    "@inertiajs/react": "3.7.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.6"
  }
}
